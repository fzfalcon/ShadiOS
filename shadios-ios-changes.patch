+    }
+}
+
+bool Emulator::IsPaused() const {
+    return DebugState.IsGuestThreadsPaused();
+}
+
+std::optional<std::filesystem::path>
+Emulator::TakePendingRestart(std::vector<std::string>& out_args) {
+    if (!pending_restart_path.has_value()) {
+        return std::nullopt;
